# Copy to .env and fill in. .env is gitignored — do not commit real keys.
# Gemini derives structured skill graphs and labels grounded search results.
GEMINI_API_KEY=...
# Tavily performs the live web search used for resource discovery.
TAVILY_API_KEY=tvly-...

# Gemini Flash keeps the first goal build quick and works with the free tier.
LPR_MODEL=gemini-3.6-flash

# When true the app never calls the API. Cached goals/resources can still be
# reused, but a new goal returns an honest unavailable response.
LPR_OFFLINE=false

# Optional. If sentence-transformers is installed we use it for embeddings,
# otherwise retrieval falls back to TF-IDF. Set to false to force the fallback.
LPR_USE_EMBEDDINGS=true
